# ESP32_BASE_URL e carregado pelo comando de captura e pelo painel local.
# Host e porta do atalho iniciar-monitor.bat sao 127.0.0.1:8000.
# APP_HOST/APP_PORT/LOG_LEVEL abaixo sao reservados; nao substituem argumentos do Uvicorn.
# Copie para .env na raiz. Nunca preencha credenciais reais neste exemplo.
APP_HOST=127.0.0.1
APP_PORT=8000
# Endereco ilustrativo: substituir pelo IP local da ESP32-CAM.
ESP32_BASE_URL=http://192.168.1.50
LED_MODE=simulation
LOG_LEVEL=INFO
